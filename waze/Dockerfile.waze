FROM public.ecr.aws/lambda/python:3.13@sha256:31814562fc6d222dd84bf659ae2f0a1bb5ac17b7d217e9c734c7612e326e7559

COPY waze/requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

COPY waze/waze_latest.py ${LAMBDA_TASK_ROOT}/
COPY waze/waze_reaper.py ${LAMBDA_TASK_ROOT}/
COPY waze/test_schema_validation.py ${LAMBDA_TASK_ROOT}/
COPY waze/.env ${LAMBDA_TASK_ROOT}/.env
COPY schemas/waze.json ${LAMBDA_TASK_ROOT}/schemas/waze.json
COPY shared/ ${LAMBDA_TASK_ROOT}/shared/

ENV HOME="/tmp"

# Run schema validation test during build - fails if data doesn't match schema
WORKDIR ${LAMBDA_TASK_ROOT}
RUN pytest test_schema_validation.py -v

CMD ["waze_latest.handler"]
